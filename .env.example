# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will not be committed to source control.

# Your Alma Shelflist API key (read-only access to Bibs and Configuration).
# This value is read by key.php at runtime.
ALMA_SHELFLIST_API_KEY=your_api_key_here

# Optional: Dedicated Alma Analytics API key and Analytics Report path in Alma
# If ALMA_ANALYTICS_API_KEY is omitted, ALMA_SHELFLIST_API_KEY will be used.
ALMA_ANALYTICS_API_KEY=your_analytics_api_key_here
ALMA_ANALYTICS_REPORT_PATH=/shared/Purdue University/Reports/CallNumberSortCheck

# SAML Service Provider (SP) Configuration
SAML_SP_ENTITY_ID=https://localhost:8443/saml/metadata
SAML_SP_ACS_URL=https://localhost:8443/saml/acs

# SAML Identity Provider (IdP) Configuration (Purdue OpenAthens)
SAML_IDP_ENTITY_ID=https://idp.purdue.edu/entity
SAML_IDP_SSO_URL=https://login.openathens.net/saml/2/sso/purdue.edu
SAML_IDP_CERT_PATH=/srv/app/keys/idp.crt

# Authorization allow-list path
ALLOWED_USERS_FILE=/srv/app/allowed_users.txt